# Road To Halal Environment Variables
# Secret JWT minimal 32 karakter
SESSION_SECRET="roadtohalal_super_secret_jwt_key_at_least_32_chars_2026"

# Direktori penyimpanan JSON & upload (di cPanel letakkan di luar public_html, misal: /home/username/roadtohalal-data)
DATA_DIR="./roadtohalal-data"

# Email Super Admin
ADMIN_EMAIL="admin@roadtohalal.id"

# URL Aplikasi
APP_URL="http://localhost:3000"

# Pengaturan SMTP (opsional di lokal, aktifkan di cPanel untuk kirim email & lupa password)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Road To Halal <noreply@roadtohalal.id>"
