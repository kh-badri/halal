# ----------------------------------------------------------------------
# Road To Halal - Production .htaccess for cPanel Apache / LiteSpeed
# Static HTML + Native PHP Backend (Zero Node.js Process Required)
# ----------------------------------------------------------------------

DirectoryIndex index.html index.php
Options -Indexes +FollowSymLinks
RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Security: Block direct web access to sensitive JSON & data directories
RewriteRule ^roadtohalal-data/ - [F,L]
RewriteRule \.(json|bak|tmp|log|md|lock|yml)$ - [F,L]

# 3. Route API requests to Native PHP Router
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/(.*)$ api/index.php?endpoint=$1 [QSA,L]

# 4. Clean URLs for Next.js Static Export
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)$ $1.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# 5. PWA MIME Types
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType application/javascript .js
    AddType text/css .css
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
</IfModule>

# 6. Gzip / Brotli Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/manifest+json
</IfModule>
